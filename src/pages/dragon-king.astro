---
// src/pages/dragon-king.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import TrailerPlayer from '../components/TrailerPlayer.astro';
import KingdomStatements from '../components/KingdomStatements.astro';

const pageTitle = "Dragon King | Official Epic Action RPG Hub & Official Contact";
const metaDescription = "Enter the world of Dragon King, an upcoming high-fantasy Action RPG by Santhosh Kumar. Read royal kingdom statements of King Valen and King Malakor, and watch official trailers!";
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    
    <!-- Security Headers Meta -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta http-equiv="X-XSS-Protection" content="1; mode=block" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=()" />

    <!-- OpenGraph / Social Media SEO -->
    <meta property="og:title" content="Dragon King - Upcoming High-Fantasy Action RPG" />
    <meta property="og:description" content="Read kingdom decrees of King Valen & King Malakor, and watch the official trailer!" />
    <meta property="og:image" content="/High%20King%20Valen%20Avatar.png" />
    
    <meta name="google-adsense-account" content="ca-pub-7816244517423569" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7816244517423569" crossorigin="anonymous"></script>

    <style>
      body { -webkit-font-smoothing: antialiased; }
    </style>
  </head>
  <body class="bg-slate-950 text-slate-200 selection:bg-amber-500/30 font-sans leading-tight overflow-x-hidden">
    
    <!-- Top Navigation Header -->
    <Navbar />

    <main class="relative">
      
      <!-- HERO SECTION WITH EPIC DRAGON BANNER -->
      <section class="relative min-h-[85vh] flex items-center justify-center pt-8 pb-20 overflow-hidden border-b border-slate-900">
        <!-- Background Hero Image with Dark Gradient Overlay -->
        <div class="absolute inset-0 z-0">
          <img 
            src="/dragon-king-hero.jpg" 
            alt="Dragon King Hero Artwork" 
            draggable="false"
            oncontextmenu="return false;"
            class="w-full h-full object-cover opacity-35 scale-105 filter brightness-75 hover:scale-100 transition-transform duration-1000"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-slate-950/30"></div>
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-amber-500/10 via-transparent to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-5 text-center space-y-8">
          <!-- Tagline Badge -->
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-900/90 border border-amber-500/40 text-amber-400 text-xs font-mono font-bold uppercase tracking-widest backdrop-blur-md shadow-lg shadow-amber-950/50">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
            Upcoming Flagship Action RPG • Mobile & PC
          </div>

          <!-- Main Title -->
          <h1 class="text-5xl sm:text-7xl md:text-9xl font-black tracking-tighter text-white uppercase leading-none">
            DRAGON <span class="bg-gradient-to-r from-amber-400 via-orange-500 to-red-600 bg-clip-text text-transparent">KING</span>
          </h1>

          <p class="text-lg md:text-2xl text-slate-300 max-w-3xl mx-auto font-light leading-relaxed">
            Unleash mythic dragon abilities, conquer elemental boss raids, and forge your legend in an immersive open high-fantasy world.
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
            <a 
              href="#kingdoms" 
              class="w-full sm:w-auto px-6 py-4 rounded-2xl bg-gradient-to-r from-amber-500 via-orange-500 to-purple-600 text-slate-950 font-black text-sm uppercase tracking-wider shadow-xl shadow-amber-500/20 hover:scale-105 active:scale-95 transition-all flex items-center justify-center gap-2"
            >
              <span>📜 KINGDOM STATEMENTS</span>
            </a>
            <a 
              href="#trailer" 
              class="w-full sm:w-auto px-6 py-4 rounded-2xl bg-slate-900/90 border border-slate-700 text-amber-400 hover:text-white hover:border-amber-500 font-mono font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 backdrop-blur-md"
            >
              <span>🎬 TRAILER VIDEO</span>
            </a>
            <a 
              href="#official-contact" 
              class="w-full sm:w-auto px-6 py-4 rounded-2xl bg-slate-900/90 border border-slate-700 text-amber-400 hover:text-white hover:border-amber-500 font-mono font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 backdrop-blur-md"
            >
              <span>📧 OFFICIAL EMAIL</span>
            </a>
          </div>

          <!-- Live Ticker -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto pt-8 border-t border-slate-800/80 font-mono text-xs">
            <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800">
              <span class="text-slate-500 block text-[10px] uppercase">Engine</span>
              <span class="text-amber-400 font-bold">Unreal Engine 5 / Mobile</span>
            </div>
            <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800">
              <span class="text-slate-500 block text-[10px] uppercase">Genre</span>
              <span class="text-amber-400 font-bold">Action RPG / Hack & Slash</span>
            </div>
            <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800">
              <span class="text-slate-500 block text-[10px] uppercase">Official Email</span>
              <span class="text-green-400 font-bold truncate block">preregisterdragonking@gmail.com</span>
            </div>
            <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800">
              <span class="text-slate-500 block text-[10px] uppercase">Platforms</span>
              <span class="text-amber-300 font-bold">Android | iOS | Steam</span>
            </div>
          </div>
        </div>
      </section>


      <!-- OFFICIAL TRAILER VIDEO SHOWCASE -->
      <section id="trailer" class="py-20 px-5 max-w-7xl mx-auto border-b border-slate-900">
        <div class="text-center space-y-4 mb-12">
          <span class="text-amber-400 font-mono text-xs uppercase font-bold tracking-widest">Cinematic Reveal</span>
          <h2 class="text-3xl md:text-6xl font-black text-white tracking-tight">
            Watch Official <span class="text-amber-400">Game Trailer</span>
          </h2>
          <p class="text-slate-400 max-w-2xl mx-auto text-sm md:text-base">
            Watch the official cinematic reveal below!
          </p>
        </div>

        <TrailerPlayer />
      </section>


      <!-- KINGDOM RULEOVER STATEMENTS (HIGH KING VALEN & EMPEROR MALAKOR) -->
      <section id="kingdoms" class="py-20 px-5 max-w-7xl mx-auto border-b border-slate-900">
        <KingdomStatements />
      </section>


      <!-- LORE & CHAMPIONS SHOWCASE -->
      <section id="champions" class="py-20 px-5 max-w-7xl mx-auto border-b border-slate-900">
        <div class="text-center space-y-4 mb-16">
          <span class="text-red-500 font-mono text-xs uppercase font-bold tracking-widest">Mythic Beings</span>
          <h2 class="text-3xl md:text-6xl font-black text-white tracking-tight">
            Choose Your <span class="bg-gradient-to-r from-red-500 via-amber-400 to-yellow-300 bg-clip-text text-transparent">Dragon Sovereign</span>
          </h2>
          <p class="text-slate-400 max-w-2xl mx-auto text-sm md:text-base">
            Each Dragon Sovereign wields unique elemental magic, ultimate abilities, and weapon masteries. Select a Sovereign below to inspect stats.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
          <!-- Champion Selector Cards -->
          <div class="space-y-4">
            <button 
              data-champion="ignis" 
              class="champ-btn w-full text-left p-5 rounded-2xl bg-slate-900 border border-amber-500/50 hover:border-amber-400 transition-all flex items-center gap-4 group active-champ"
            >
              <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-red-600 to-amber-500 flex items-center justify-center text-2xl shadow-lg shadow-red-950">
                🔥
              </div>
              <div>
                <h4 class="text-lg font-bold text-white group-hover:text-amber-300">Ignis, Flame Sovereign</h4>
                <span class="text-xs font-mono text-amber-400">Element: Pure Inferno Fire</span>
              </div>
            </button>

            <button 
              data-champion="frostwing" 
              class="champ-btn w-full text-left p-5 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-slate-600 transition-all flex items-center gap-4 group"
            >
              <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-cyan-600 to-blue-500 flex items-center justify-center text-2xl shadow-lg">
                ❄️
              </div>
              <div>
                <h4 class="text-lg font-bold text-white group-hover:text-cyan-300">Frostwing Monarch</h4>
                <span class="text-xs font-mono text-cyan-400">Element: Glacial Cryo Ice</span>
              </div>
            </button>

            <button 
              data-champion="tempest" 
              class="champ-btn w-full text-left p-5 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-slate-600 transition-all flex items-center gap-4 group"
            >
              <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-purple-600 to-indigo-500 flex items-center justify-center text-2xl shadow-lg">
                ⚡
              </div>
              <div>
                <h4 class="text-lg font-bold text-white group-hover:text-purple-300">Tempest Storm Drake</h4>
                <span class="text-xs font-mono text-purple-400">Element: Lightning Storm</span>
              </div>
            </button>

            <button 
              data-champion="shadow" 
              class="champ-btn w-full text-left p-5 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-slate-600 transition-all flex items-center gap-4 group"
            >
              <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-slate-700 to-slate-900 flex items-center justify-center text-2xl shadow-lg">
                👁️
              </div>
              <div>
                <h4 class="text-lg font-bold text-white group-hover:text-slate-300">Shadow Void Wyrm</h4>
                <span class="text-xs font-mono text-slate-400">Element: Dark Void Magic</span>
              </div>
            </button>
          </div>

          <!-- Dynamic Display Box for Selected Champion -->
          <div class="lg:col-span-2 rounded-3xl bg-slate-900 border border-slate-800 p-8 shadow-2xl space-y-6 relative overflow-hidden">
            <div class="flex justify-between items-start">
              <div>
                <span id="champElement" class="text-xs font-mono font-bold text-amber-400 uppercase tracking-widest block">Inferno Class</span>
                <h3 id="champTitle" class="text-3xl md:text-4xl font-black text-white">Ignis, Flame Sovereign</h3>
              </div>
              <div id="champBadge" class="px-4 py-2 rounded-xl bg-red-600/20 border border-red-500/40 text-red-300 font-mono text-xs font-bold uppercase">
                SSR Sovereign
              </div>
            </div>

            <p id="champLore" class="text-slate-300 text-base leading-relaxed">
              Born inside the molten core of Mount Pyre, Ignis wields absolute mastery over holy dragonflame. His fiery roar incinerates legions of dark shadows and grants relentless damage boosts to allies.
            </p>

            <!-- Attributes & Skill Meter -->
            <div class="space-y-4 pt-4 border-t border-slate-800 font-mono">
              <div>
                <div class="flex justify-between text-xs font-bold mb-1">
                  <span class="text-slate-400">ATTACK POWER</span>
                  <span id="statAtk" class="text-amber-400">98 / 100</span>
                </div>
                <div class="w-full bg-slate-950 h-2.5 rounded-full overflow-hidden p-0.5 border border-slate-800">
                  <div id="barAtk" class="bg-gradient-to-r from-red-600 to-amber-400 h-full rounded-full transition-all duration-500" style="width: 98%;"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-xs font-bold mb-1">
                  <span class="text-slate-400">ELEMENTAL FLAME MASTERY</span>
                  <span id="statMagic" class="text-amber-400">95 / 100</span>
                </div>
                <div class="w-full bg-slate-950 h-2.5 rounded-full overflow-hidden p-0.5 border border-slate-800">
                  <div id="barMagic" class="bg-gradient-to-r from-amber-500 to-orange-400 h-full rounded-full transition-all duration-500" style="width: 95%;"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-xs font-bold mb-1">
                  <span class="text-slate-400">DEFENSE & SHIELDING</span>
                  <span id="statDef" class="text-amber-400">75 / 100</span>
                </div>
                <div class="w-full bg-slate-950 h-2.5 rounded-full overflow-hidden p-0.5 border border-slate-800">
                  <div id="barDef" class="bg-gradient-to-r from-slate-600 to-amber-500 h-full rounded-full transition-all duration-500" style="width: 75%;"></div>
                </div>
              </div>
            </div>

            <!-- Ultimate Skill Preview -->
            <div class="p-4 bg-slate-950 rounded-2xl border border-slate-800 flex items-center gap-4">
              <div class="text-3xl">💥</div>
              <div>
                <span class="text-[10px] font-mono text-slate-500 uppercase block">ULTIMATE ABILITY</span>
                <h5 id="champUltimate" class="text-sm font-bold text-white">Infernal Cataclysm</h5>
                <p id="champUltimateDesc" class="text-xs text-slate-400">Unleashes a tidal wave of primordial flame dealing 450% AoE Fire Damage.</p>
              </div>
            </div>
          </div>
        </div>
      </section>


      <!-- CORE GAME FEATURES GRID -->
      <section class="py-20 px-5 max-w-7xl mx-auto border-b border-slate-900">
        <div class="text-center space-y-4 mb-16">
          <span class="text-amber-400 font-mono text-xs uppercase font-bold tracking-widest">Next-Gen Gameplay</span>
          <h2 class="text-3xl md:text-6xl font-black text-white tracking-tight">
            Built for <span class="text-amber-400">Thrill & Precision</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-8 rounded-3xl bg-slate-900 border border-slate-800 hover:border-amber-500/40 transition-all space-y-4">
            <div class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-2xl text-amber-400">
              ⚔️
            </div>
            <h3 class="text-2xl font-bold text-white">Real-Time Combat</h3>
            <p class="text-slate-400 text-sm leading-relaxed">
              Fluid 60FPS hack-and-slash combat system with instant dodge rolls, elemental combos, and dragon transformation triggers.
            </p>
          </div>

          <div class="p-8 rounded-3xl bg-slate-900 border border-slate-800 hover:border-amber-500/40 transition-all space-y-4">
            <div class="w-14 h-14 rounded-2xl bg-red-500/10 border border-red-500/30 flex items-center justify-center text-2xl text-red-400">
              🐉
            </div>
            <h3 class="text-2xl font-bold text-white">Guild Dragon Raids</h3>
            <p class="text-slate-400 text-sm leading-relaxed">
              Team up with up to 8 players in co-op boss raids to take down ancient colossal Titans and unlock legendary loot caches.
            </p>
          </div>

          <div class="p-8 rounded-3xl bg-slate-900 border border-slate-800 hover:border-amber-500/40 transition-all space-y-4">
            <div class="w-14 h-14 rounded-2xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-2xl text-indigo-400">
              🌐
            </div>
            <h3 class="text-2xl font-bold text-white">Cross-Platform Sync</h3>
            <p class="text-slate-400 text-sm leading-relaxed">
              Seamlessly continue your adventure across Android, iOS, and PC with unified cloud saves and cross-play servers.
            </p>
          </div>
        </div>
      </section>





      <!-- DEVLOG & ROADMAP TIMELINE -->
      <section id="devlog" class="py-20 px-5 max-w-7xl mx-auto border-b border-slate-900">
        <div class="text-center space-y-4 mb-16">
          <span class="text-amber-400 font-mono text-xs uppercase font-bold tracking-widest">Development Roadmap</span>
          <h2 class="text-3xl md:text-6xl font-black text-white tracking-tight">
            Journey to <span class="text-amber-400">Global Launch</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative">
          <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 relative space-y-3">
            <span class="px-2.5 py-1 rounded bg-green-500/20 text-green-400 font-mono text-[10px] font-bold uppercase">Phase 1 • COMPLETED</span>
            <h4 class="text-xl font-bold text-white">Concept & Core Engine</h4>
            <p class="text-xs text-slate-400">Unreal Engine mobile architecture setup, combat prototyping, and dragon lore design.</p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-900 border-2 border-amber-500 relative space-y-3 shadow-xl shadow-amber-950/40">
            <span class="px-2.5 py-1 rounded bg-amber-500/20 text-amber-300 font-mono text-[10px] font-bold uppercase animate-pulse">Phase 2 • CURRENT</span>
            <h4 class="text-xl font-bold text-amber-300">Game Reveal & Official Channel</h4>
            <p class="text-xs text-slate-300">Cinematic trailer release, monarch decrees of King Valen & Emperor Malakor, and official email channel setup.</p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-3">
            <span class="px-2.5 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px] font-bold uppercase">Phase 3 • UPCOMING</span>
            <h4 class="text-xl font-bold text-white">Closed Alpha Playtest</h4>
            <p class="text-xs text-slate-400">Selected pre-registered founders will receive playtest keys to test combat and multi-player raids.</p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-3">
            <span class="px-2.5 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px] font-bold uppercase">Phase 4 • 2027</span>
            <h4 class="text-xl font-bold text-white">Global Release</h4>
            <p class="text-xs text-slate-400">Worldwide release on Google Play Store, Apple App Store, and Steam PC.</p>
          </div>
        </div>
      </section>


      <!-- OFFICIAL EMAIL COMMUNICATIONS & USER NOTIFICATIONS DESK -->
      <section id="official-contact" class="py-20 px-5 max-w-7xl mx-auto border-b border-slate-900">
        <div class="text-center space-y-4 mb-12">
          <span class="text-amber-400 font-mono text-xs uppercase font-bold tracking-widest">Official Single Email Hub</span>
          <h2 class="text-3xl md:text-6xl font-black text-white tracking-tight">
            Official Game <span class="bg-gradient-to-r from-amber-400 via-orange-400 to-red-500 bg-clip-text text-transparent">Email Address</span>
          </h2>
          <p class="text-slate-400 max-w-2xl mx-auto text-sm md:text-base">
            All warrior pre-registrations, playtest invitations, user update notifications, and official inquiries are managed exclusively through our unified official email.
          </p>
        </div>

        <div class="max-w-4xl mx-auto p-8 rounded-3xl bg-slate-900 border-2 border-amber-500/40 shadow-2xl space-y-8">
          <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-6 border-b border-slate-800">
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-3xl text-amber-400 shadow-lg shadow-amber-950/50 shrink-0">
                ✉️
              </div>
              <div>
                <span class="text-xs font-mono text-amber-400 uppercase font-bold tracking-widest block">Official Game Email Identity</span>
                <h3 class="text-2xl sm:text-3xl font-black text-white font-mono tracking-tight mt-1">preregisterdragonking@gmail.com</h3>
              </div>
            </div>
            <a 
              href="mailto:preregisterdragonking@gmail.com?subject=Dragon%20King%20Inquiry&body=Hello%20Santhosh,%0D%0A%0D%0AI%20am%20interested%20in%20Dragon%20King!" 
              class="px-6 py-3 bg-gradient-to-r from-amber-400 via-orange-500 to-red-600 text-slate-950 font-black rounded-xl text-xs uppercase tracking-wider hover:scale-105 transition-all shadow-lg shadow-amber-500/20 shrink-0"
            >
              Send Mail to Us →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
            <div class="p-5 rounded-2xl bg-slate-950/80 border border-slate-800 space-y-2">
              <div class="text-amber-400 font-mono font-bold text-xs flex items-center gap-2">
                <span>📜 Pre-Registrations</span>
              </div>
              <p class="text-xs text-slate-400 leading-relaxed">
                Submit your gamer tag & email to register for official game updates and playtest announcements.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-slate-950/80 border border-slate-800 space-y-2">
              <div class="text-green-400 font-mono font-bold text-xs flex items-center gap-2">
                <span>🔔 User Updates</span>
              </div>
              <p class="text-xs text-slate-400 leading-relaxed">
                Direct mail delivery for balance patches, developer notes, kingdom lore, and upcoming playtest invites.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-slate-950/80 border border-slate-800 space-y-2">
              <div class="text-purple-400 font-mono font-bold text-xs flex items-center gap-2">
                <span>🛡️ Playtest & Support</span>
              </div>
              <p class="text-xs text-slate-400 leading-relaxed">
                Receive closed alpha access keys, technical support, and press/media kits directly from lead developer Santhosh Kumar.
              </p>
            </div>
          </div>
        </div>
      </section>



    </main>

    <!-- Footer -->
    <footer class="py-12 border-t border-slate-900 bg-slate-950 text-center space-y-4">
      <div class="max-w-7xl mx-auto px-5 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-mono text-slate-500 uppercase">
        <p>&copy; 2026 Vidudala Santhosh Kumar. All rights reserved.</p>
        <p>Dragon King Project • Action RPG Game Hub</p>
      </div>
    </footer>

    <!-- Interactive Champion Selector Script -->
    <script>
      const champions = {
        ignis: {
          title: 'Ignis, Flame Sovereign',
          element: 'Inferno Class',
          badge: 'SSR Sovereign',
          lore: 'Born inside the molten core of Mount Pyre, Ignis wields absolute mastery over holy dragonflame. His fiery roar incinerates legions of dark shadows and grants relentless damage boosts to allies.',
          atk: 98,
          magic: 95,
          def: 75,
          ultimate: 'Infernal Cataclysm',
          ultimateDesc: 'Unleashes a tidal wave of primordial flame dealing 450% AoE Fire Damage.'
        },
        frostwing: {
          title: 'Frostwing Monarch',
          element: 'Glacial Cryo Class',
          badge: 'SSR Sovereign',
          lore: 'Ruling over the eternal snows of the Northern Ridge, Frostwing encapsulates enemies in impenetrable glacial ice and shields allies with crystalline frost barrier armor.',
          atk: 82,
          magic: 92,
          def: 96,
          ultimate: 'Absolute Zero Permafrost',
          ultimateDesc: 'Freezes all battlefield enemies for 4 seconds while shattering physical defense by 50%.'
        },
        tempest: {
          title: 'Tempest Storm Drake',
          element: 'Lightning Blitz Class',
          badge: 'SSR Sovereign',
          lore: 'Riding the roaring thunder clouds, Tempest moves with lightning speed to pierce enemy backlines before they can react.',
          atk: 95,
          magic: 88,
          def: 68,
          ultimate: 'Thundergod Judgment',
          ultimateDesc: 'Summons 12 strike bolts dealing chain lightning damage across enemy squads.'
        },
        shadow: {
          title: 'Shadow Void Wyrm',
          element: 'Dark Void Class',
          badge: 'Mythic Sovereign',
          lore: 'Emerging from the abyssal rift, Shadow Void Wyrm absorbs enemy health to fuel its dark spell casting and phase through physical attacks.',
          atk: 91,
          magic: 99,
          def: 70,
          ultimate: 'Abyssal Black Hole',
          ultimateDesc: 'Pulls all surrounding targets into a void singularity, draining 30% of max HP.'
        }
      };

      document.querySelectorAll('.champ-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-champion');
          const data = champions[key];
          if (!data) return;

          document.querySelectorAll('.champ-btn').forEach(b => {
            b.classList.remove('border-amber-500/50', 'active-champ');
            b.classList.add('border-slate-800');
          });
          btn.classList.add('border-amber-500/50', 'active-champ');
          btn.classList.remove('border-slate-800');

          document.getElementById('champTitle').textContent = data.title;
          document.getElementById('champElement').textContent = data.element;
          document.getElementById('champBadge').textContent = data.badge;
          document.getElementById('champLore').textContent = data.lore;
          document.getElementById('statAtk').textContent = data.atk + ' / 100';
          document.getElementById('statMagic').textContent = data.magic + ' / 100';
          document.getElementById('statDef').textContent = data.def + ' / 100';

          (document.getElementById('barAtk') as HTMLElement).style.width = data.atk + '%';
          (document.getElementById('barMagic') as HTMLElement).style.width = data.magic + '%';
          (document.getElementById('barDef') as HTMLElement).style.width = data.def + '%';

          document.getElementById('champUltimate').textContent = data.ultimate;
          document.getElementById('champUltimateDesc').textContent = data.ultimateDesc;
        });
      });
    </script>
  </body>
</html>
