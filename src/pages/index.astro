---
// src/pages/index.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

const pageTitle = "Vidudala Santhosh Kumar | Portfolio & Game Hub";
const snapStoreLink = "https://play.google.com/store/apps/details?id=com.snap2contacts";
const emailContact = "mailto:preregisterdragonking@gmail.com"; 
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{pageTitle}</title>
		
		<!-- Security Headers Meta -->
		<meta http-equiv="X-Content-Type-Options" content="nosniff" />
		<meta http-equiv="X-Frame-Options" content="DENY" />
		<meta http-equiv="X-XSS-Protection" content="1; mode=block" />
		<meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
		<meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=()" />

		<meta name="google-adsense-account" content="ca-pub-7816244517423569">
		<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7816244517423569" crossorigin="anonymous"></script>

		<style>
			html { scroll-behavior: smooth; }
			body { -webkit-font-smoothing: antialiased; }
		</style>
	</head>
	<body class="bg-slate-950 text-slate-200 selection:bg-amber-500/30 font-sans leading-tight overflow-x-hidden text-pretty">
		
		<!-- Global Navigation Bar -->
		<Navbar />

		<main class="max-w-7xl mx-auto px-5 py-8 md:py-16">
			
			<!-- Hero Header -->
			<header class="mb-12 space-y-6 text-center md:text-left">
				<div class="inline-block px-4 py-1.5 rounded-full border border-slate-800 bg-slate-900/50 text-[10px] font-mono uppercase tracking-widest text-amber-400">
					Available for Collaboration & Game Projects
				</div>
				<h1 class="text-5xl md:text-8xl font-black tracking-tighter bg-gradient-to-br from-white via-slate-300 to-slate-600 bg-clip-text text-transparent leading-[1.1]">
					Santhosh Kumar
				</h1>
				<p class="text-xl md:text-2xl text-slate-400 max-w-3xl mx-auto md:mx-0 font-light leading-relaxed">
					Manager in <span class="text-white font-medium">Financial Sector</span>, <span class="text-amber-400 font-medium font-mono uppercase text-sm tracking-wider">Game Developer</span> & <span class="text-indigo-400 font-medium font-mono tracking-tighter text-sm uppercase">Android Developer</span>. 
				</p>
			</header>

			<!-- FEATURED SPOTLIGHT: DRAGON KING GAME -->
			<section class="mb-12 group relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-red-950/80 border-2 border-amber-500/40 p-8 md:p-12 shadow-2xl hover:border-amber-400 transition-all duration-500">
				<!-- Embers Accent Background -->
				<div class="absolute -right-20 -bottom-20 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

				<div class="flex flex-col lg:flex-row gap-10 items-center justify-between relative z-10">
					<div class="space-y-6 max-w-2xl">
						<div class="flex flex-wrap items-center gap-3">
							<span class="px-3 py-1 rounded-full bg-red-600/30 border border-red-500/50 text-red-300 font-mono text-xs font-bold uppercase tracking-widest animate-pulse">
								★ Flagship Game Title
							</span>
							<span class="text-xs font-mono text-amber-400 font-bold">
								Android | iOS | Steam PC
							</span>
						</div>

						<h2 class="text-4xl sm:text-6xl font-black text-white tracking-tight uppercase leading-none">
							DRAGON <span class="bg-gradient-to-r from-amber-400 via-orange-500 to-red-600 bg-clip-text text-transparent">KING</span>
						</h2>

						<p class="text-slate-300 text-lg md:text-xl leading-relaxed font-light">
							An epic high-fantasy Action RPG featuring real-time dragon combat, elemental boss raids, and open-world exploration. 
						</p>

						<!-- Game Feature Pills -->
						<div class="flex flex-wrap gap-2 text-xs font-mono">
							<span class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-amber-300 font-bold">🎬 Official Cinematic Trailer</span>
							<span class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-amber-300 font-bold">🎁 Pre-Register Founder Pass</span>
							<span class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-amber-300 font-bold">🐉 4 Elemental Sovereigns</span>
						</div>

						<div class="flex flex-col sm:flex-row gap-4 pt-2">
							<a 
								href="/dragon-king" 
								class="px-8 py-4 rounded-2xl bg-gradient-to-r from-amber-400 via-orange-500 to-red-600 text-slate-950 font-black text-base uppercase tracking-wider shadow-lg shadow-amber-500/20 hover:scale-105 active:scale-95 transition-all text-center"
							>
								ENTER DRAGON KING GAME HUB →
							</a>
							<a 
								href="/dragon-king#trailer" 
								class="px-6 py-4 rounded-2xl bg-slate-900 border border-slate-700 text-amber-400 font-mono font-bold text-sm uppercase tracking-wider hover:bg-slate-800 transition-all text-center"
							>
								Watch Trailer
							</a>
						</div>
					</div>

					<!-- Hero Visual Card -->
					<div class="w-full lg:w-96 aspect-[16/10] rounded-3xl overflow-hidden border-2 border-amber-500/30 shadow-2xl shrink-0 group-hover:border-amber-400 transition-all duration-500">
						<img 
							src="/dragon-king-hero.jpg" 
							alt="Dragon King Hero Banner" 
							draggable="false"
							oncontextmenu="return false;"
							class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" 
						/>
					</div>
				</div>
			</section>


			<!-- OTHER PROJECTS GRID -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-8 mb-8">
				
				<!-- Snap2Contacts Card -->
				<div class="md:col-span-2 group relative overflow-hidden rounded-[2.5rem] bg-slate-900 border border-slate-800 p-8 md:p-12 hover:border-indigo-500/50 transition-all duration-500">
					<div class="flex flex-col md:flex-row gap-10 items-start">
						<div class="relative z-10 flex-1 space-y-4">
							<div class="mb-8 w-20 h-20 rounded-[1.5rem] bg-white p-3 border border-slate-800 shadow-xl">
								<img src="/snap-icon.png" alt="Snap2Contacts Icon" draggable="false" oncontextmenu="return false;" class="w-full h-full object-contain" />
							</div>
							<div class="flex items-center gap-2 mb-4">
								<span class="relative flex h-3 w-3"><span class="animate-ping absolute h-full w-full rounded-full bg-green-400 opacity-75"></span><span class="relative h-3 w-3 rounded-full bg-green-500"></span></span>
								<span class="text-[10px] font-bold text-indigo-400 uppercase tracking-widest">Live on Play Store</span>
							</div>
							<h2 class="text-4xl font-bold tracking-tight">Snap2Contacts</h2>
							<p class="text-slate-400 text-lg leading-relaxed">
								A high-performance productivity tool utilizing offline-first OCR to instantly extract contacts from WhatsApp screenshots.
							</p>
							<a href={snapStoreLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-white text-black px-8 py-4 rounded-2xl font-bold transition-all hover:bg-indigo-500 hover:text-white active:scale-95">Get App</a>
						</div>
						<div class="relative w-full md:w-56 aspect-[9/16] bg-slate-800 rounded-3xl overflow-hidden border border-slate-700 shadow-2xl self-center shrink-0">
							<img src="https://images.unsplash.com/photo-1616353071588-708dcff912e2?auto=format&fit=crop&q=80&w=400" draggable="false" oncontextmenu="return false;" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"/>
						</div>
					</div>
				</div>

				<!-- Partner Content / Ad Banner -->
				<div class="group relative overflow-hidden rounded-[2.5rem] bg-slate-900/80 border border-slate-800 p-8 flex flex-col items-center justify-center min-h-[300px] transition-all hover:border-indigo-500/30">
					<div class="absolute top-4 left-6 flex items-center gap-2">
						<span class="text-[8px] font-mono text-slate-500 uppercase tracking-[0.2em] font-bold">Partner Content</span>
					</div>
					<div class="w-full h-full flex items-center justify-center">
						<ins class="adsbygoogle"
							 style="display:block"
							 data-ad-client="ca-pub-7816244517423569"
							 data-ad-slot="default"
							 data-ad-format="auto"
							 data-full-width-responsive="true"></ins>
						<script> (adsbygoogle = window.adsbygoogle || []).push({}); </script>
					</div>
				</div>

				<!-- FinServe Pro -->
				<div class="md:col-span-2 group relative overflow-hidden rounded-[2.5rem] bg-slate-900/40 border border-dashed border-slate-700 p-10 hover:border-slate-500 transition-all duration-500 flex flex-col justify-between">
					<div>
						<div class="mb-10 w-24 h-24 rounded-3xl bg-slate-800 p-4 border border-slate-700 shadow-xl group-hover:bg-slate-700 transition-colors">
							<img src="/finserve-pro.png" alt="FinServe Pro Icon" draggable="false" oncontextmenu="return false;" class="w-full h-full object-contain" onerror="this.src='https://www.svgrepo.com/show/422280/shield-lock.svg'"/>
						</div>
						<h2 class="text-3xl font-bold mb-4 tracking-tight text-slate-300">FinServe Pro</h2>
						<p class="text-slate-500 italic text-sm leading-relaxed max-w-2xl">
							Specialized management and counseling suite designed for professional monitoring, data integrity, and operational oversight within the financial sector.
						</p>
					</div>
					<div class="flex items-center gap-2 mt-6">
						<span class="relative flex h-2 w-2">
							<span class="animate-ping absolute h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
							<span class="relative h-2 w-2 rounded-full bg-indigo-500"></span>
						</span>
						<span class="text-[10px] font-mono text-indigo-400 font-bold uppercase tracking-widest">Internal Beta</span>
					</div>
				</div>

				<!-- Let's Connect Card -->
				<div class="rounded-[2.5rem] bg-slate-900 border border-slate-800 p-8 flex flex-col items-center text-center hover:border-amber-500/30 transition-all">
					<div class="w-24 h-24 rounded-full overflow-hidden border-4 border-slate-800 shadow-2xl mb-6">
						<img src="/santhosh.jpg" draggable="false" oncontextmenu="return false;" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700" alt="Santhosh Kumar" />
					</div>
					<h3 class="text-2xl font-bold text-white mb-2 uppercase tracking-widest leading-none">Let's Connect</h3>
					<p class="text-xs text-slate-400 font-mono mb-2">Official Email Desk</p>
					<div class="flex flex-col w-full gap-3 mt-2">
						<a 
							href={emailContact} 
							class="py-3 px-4 bg-gradient-to-r from-amber-400 via-orange-500 to-red-600 text-slate-950 font-black font-mono text-xs uppercase tracking-wider rounded-xl hover:scale-105 transition-all text-center break-all shadow-lg shadow-amber-500/20"
						>
							preregisterdragonking@gmail.com
						</a>
					</div>
				</div>
			</div>

			<!-- AI Article Section -->
			<section class="mt-12 rounded-[3rem] bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-800 p-8 md:p-16 relative overflow-hidden shadow-inner">
				<div class="max-w-4xl mx-auto space-y-12 text-pretty">
					<header class="text-center space-y-4">
						<span class="text-amber-400 font-mono text-xs uppercase tracking-[0.3em] font-bold">Thought Leadership</span>
						<h2 class="text-4xl md:text-7xl font-black text-white tracking-tight leading-tight">Artificial Intelligence: <br/><span class="text-amber-400 italic">Promise, Power, and Challenges</span></h2>
						<p class="text-slate-500 font-mono text-sm uppercase font-bold">By Vidudala Santhoshkumar</p>
					</header>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-slate-300 text-lg leading-relaxed">
						<div class="space-y-6">
							<p>Knowledge has always been our guiding lantern. Artificial Intelligence (AI) is the latest extension—designed specifically to assist human life.</p>
							<div class="p-6 bg-amber-500/5 rounded-3xl border border-amber-500/10 italic text-amber-300 text-center text-lg">"AI should remain a companion to human intelligence, not its replacement."</div>
						</div>
						<div class="space-y-6">
							<p>The future of AI must focus on preserving human wisdom and responsibility. With ethical innovation, AI can illuminate a future of progress and trust.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Footer -->
			<footer class="mt-24 pt-12 border-t border-slate-900 flex flex-col md:flex-row justify-between items-center gap-6 text-slate-600 text-[10px] font-bold uppercase tracking-widest">
				<p>&copy; 2026 Vidudala Santhosh Kumar. All rights reserved.</p>
				<p>Manager | Developer | Thinker</p>
			</footer>
		</main>
	</body>
</html>