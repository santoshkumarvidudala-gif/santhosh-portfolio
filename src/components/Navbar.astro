---
// src/components/Navbar.astro
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 backdrop-blur-xl bg-slate-950/80 border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-5 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 via-red-600 to-indigo-600 p-[2px] shadow-lg shadow-red-950/50 group-hover:scale-105 transition-transform duration-300">
        <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center font-black text-amber-400 text-lg">
          SK
        </div>
      </div>
      <div>
        <span class="text-white font-bold text-lg tracking-tight block leading-none group-hover:text-amber-400 transition-colors">Santhosh Kumar</span>
        <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider block">Manager & Game Dev</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 font-mono text-xs uppercase tracking-wider font-semibold">
      <a 
        href="/" 
        class={`px-4 py-2 rounded-xl transition-all ${currentPath === '/' ? 'bg-slate-800 text-white border border-slate-700' : 'text-slate-400 hover:text-white hover:bg-slate-900'}`}
      >
        Portfolio Home
      </a>

      <!-- Highlighted Dragon King Game Hub Button -->
      <a 
        href="/dragon-king" 
        class={`relative px-5 py-2.5 rounded-xl transition-all flex items-center gap-2 group border ${currentPath === '/dragon-king' ? 'bg-gradient-to-r from-red-950/80 to-amber-950/80 text-amber-300 border-amber-500/50 shadow-lg shadow-red-950/40' : 'bg-slate-900/90 text-amber-400 border-amber-500/30 hover:border-amber-500 hover:shadow-md hover:shadow-red-950/30'}`}
      >
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute h-full w-full rounded-full bg-amber-400 opacity-75"></span>
          <span class="relative h-2 w-2 rounded-full bg-amber-500"></span>
        </span>
        <span class="font-bold text-amber-300 group-hover:text-amber-200">Dragon King</span>
        <span class="px-1.5 py-0.5 text-[9px] bg-red-600/30 border border-red-500/40 rounded text-red-300 font-mono">GAME HUB</span>
      </a>

      <a 
        href="https://play.google.com/store/apps/details?id=com.snap2contacts" 
        target="_blank" 
        rel="noopener noreferrer"
        class="px-4 py-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-900 transition-all flex items-center gap-1.5"
      >
        Snap2Contacts ↗
      </a>
    </nav>

    <!-- Official Contact CTA Button -->
    <div class="flex items-center gap-3">
      <a 
        href="/dragon-king#official-contact" 
        class="relative inline-flex items-center justify-center px-5 py-2.5 font-mono text-xs uppercase font-bold tracking-wider text-slate-950 bg-gradient-to-r from-amber-400 via-amber-500 to-orange-500 rounded-xl overflow-hidden shadow-lg shadow-amber-500/20 hover:shadow-amber-500/40 hover:scale-105 active:scale-95 transition-all duration-300 group"
      >
        <span class="relative z-10 flex items-center gap-1.5">
          ✉️ Official Contact
        </span>
        <div class="absolute inset-0 bg-white/30 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
      </a>
    </div>
  </div>
</header>
